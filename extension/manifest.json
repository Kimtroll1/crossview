{
  "manifest_version": 3,
  "name": "CrossView",
  "version": "0.3.5",
  "description": "유튜브 영상의 스크립트 기반 편향도, AI 의심 여부, 다른 관점 자료를 보여주는 미디어 리터러시 도구",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://*.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/watch*"
      ],
      "js": [
        "config.js",
        "content.js"
      ],
      "css": [
        "crossview.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
