APP_VERSION=2.0.0
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_SEARCH_MODEL=gemini-3.1-flash-lite
ENABLE_GEMINI_SEARCH=true
ENABLE_URL_CONTEXT=true
RESOURCE_CACHE_HOURS=24
YOUTUBE_API_KEY=
PROMPT_VERSION=crossview-bias-v2

DATABASE_URL=postgresql+psycopg2://crossview:crossview@localhost:5432/crossview
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://www.youtube.com,https://youtube.com

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_HOURS=336
EXTENSION_TOKEN_DAYS=180
GOOGLE_CLIENT_ID=
SECRETS_ENCRYPTION_KEY=

RESEND_API_KEY=
REPORT_FROM_EMAIL=CrossView <onboarding@resend.dev>
REPORT_WORKER_KEY=replace-with-a-worker-secret
